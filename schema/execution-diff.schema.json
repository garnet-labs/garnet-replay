{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://garnet.ai/schemas/execution-diff/v1.json",
  "title": "Execution Diff",
  "description": "Base execution vs head execution for one pull request, derived from kernel-recorded Execution Profiles. A rename of the posthog evidence-injection block (build_block.py); every field is machine-derived from the record, never hand-written.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mode", "repo", "pull_request", "base", "head", "comparison", "execution_diff", "receipt_urls", "recorded", "pair", "capture", "verdict", "supersession", "claims"],
  "properties": {
    "schema_version": { "const": "execution-diff/v1" },
    "mode": {
      "type": "string",
      "enum": ["known-evidence", "live-replay"],
      "description": "known-evidence: resolved from an existing Garnet record on the PR. live-replay: recorded by the two-commit replay branch."
    },
    "label": {
      "type": "string",
      "enum": ["real", "constructed"],
      "description": "real: a pull request that existed for its own reasons. constructed: a test case authored to exercise a shape (e.g. a postinstall beacon). Rendered on every surface."
    },
    "note": { "type": "string" },
    "repo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "name", "url"],
      "properties": {
        "owner": { "type": "string" },
        "name": { "type": "string" },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "pull_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "url", "title"],
      "properties": {
        "number": { "type": "integer", "minimum": 1 },
        "url": { "type": "string", "format": "uri" },
        "title": { "type": "string" },
        "dependency": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name"],
          "properties": {
            "name": { "type": "string" },
            "from": { "type": ["string", "null"] },
            "to": { "type": ["string", "null"] }
          }
        }
      }
    },
    "base": { "$ref": "#/$defs/side" },
    "head": { "$ref": "#/$defs/side" },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available", "scope"],
      "properties": {
        "available": { "type": "boolean" },
        "scope": {
          "type": "string",
          "enum": ["previous-recorded-head-to-head", "immediate-parent-to-head", "pr-base-to-head", "constructed-pair", "unavailable"],
          "description": "Exactly which pair is compared. known-evidence compares the previous recorded head of the PR ref with the head; live-replay compares the baseline commit (immediate parent) with the update commit; pr-base-to-head compares the PR base SHA with the head; constructed-pair compares two authored demo runs from the same demo repository (base is a clean install, not the PR's own parent) and is only valid with label=constructed."
        }
      }
    },
    "execution_diff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["processes_added", "processes_removed", "network_added", "network_removed", "files_added", "files_removed", "kinds_recorded", "totals"],
      "properties": {
        "processes_added": { "type": "array", "items": { "$ref": "#/$defs/processEntry" } },
        "processes_removed": { "type": "array", "items": { "$ref": "#/$defs/processEntry" } },
        "network_added": { "type": "array", "items": { "$ref": "#/$defs/networkEntry" } },
        "network_removed": { "type": "array", "items": { "$ref": "#/$defs/networkEntry" } },
        "files_added": { "type": "array", "items": { "$ref": "#/$defs/fileEntry" } },
        "files_removed": { "type": "array", "items": { "$ref": "#/$defs/fileEntry" } },
        "kinds_recorded": {
          "type": "array",
          "items": { "type": "string", "enum": ["network", "process", "file"] },
          "description": "Observation classes present in the record. A kind absent here was not recorded, not observed-as-empty."
        },
        "steps": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Declared recorded-step names (ordinal stripped) the workload rows are restricted to."
        },
        "steps_missing": {
          "type": "object",
          "additionalProperties": false,
          "required": ["base", "head"],
          "properties": {
            "base": { "type": "array", "items": { "type": "string" } },
            "head": { "type": "array", "items": { "type": "string" } }
          }
        },
        "totals": {
          "type": "object",
          "additionalProperties": false,
          "required": ["execution_chains", "destinations", "jobs_recorded", "jobs_changed", "jobs_unchanged", "workload", "runner_background"],
          "properties": {
            "execution_chains": { "type": ["integer", "null"], "minimum": 0 },
            "destinations": { "type": ["integer", "null"], "minimum": 0 },
            "jobs_recorded": { "type": ["integer", "null"], "minimum": 0 },
            "jobs_changed": { "type": ["integer", "null"], "minimum": 0 },
            "jobs_unchanged": { "type": ["integer", "null"], "minimum": 0 },
            "workload": { "$ref": "#/$defs/addedRemoved" },
            "runner_background": { "$ref": "#/$defs/addedRemoved" }
          }
        }
      }
    },
    "receipt_urls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base", "head"],
      "properties": {
        "base": { "type": ["string", "null"], "format": "uri" },
        "head": { "type": ["string", "null"], "format": "uri" },
        "head_json": { "type": ["string", "null"], "format": "uri" },
        "pr_comment": { "type": ["string", "null"], "format": "uri" }
      }
    },
    "recorded": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at", "contract", "source"],
      "properties": {
        "at": { "type": ["string", "null"] },
        "contract": { "type": ["string", "null"], "description": "Runtime Review contract version stamped on the record." },
        "source": { "type": "string", "description": "Where the record was read from, e.g. github-app-comment, jibril-profile-json." }
      }
    },
    "pair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_sha", "head_sha", "scope", "label", "transition", "line"],
      "description": "The exact comparison pair, rendered identically on every surface as `line`.",
      "properties": {
        "base_sha": { "$ref": "#/$defs/sha" },
        "head_sha": { "$ref": "#/$defs/sha" },
        "scope": { "type": "string", "enum": ["previous-recorded-head-to-head", "immediate-parent-to-head", "pr-base-to-head", "constructed-pair", "unavailable"] },
        "label": { "type": "string", "enum": ["real", "constructed"] },
        "transition": { "type": ["string", "null"] },
        "line": { "type": "string" }
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "expected_cells", "recorded_cells", "executed_sha_verified", "lineage_missing", "final_record", "reasons"],
      "description": "Capture completeness. partial or none never reads as stable absence or variance; not-declared means the source record carries no capture accounting.",
      "properties": {
        "status": { "type": "string", "enum": ["complete", "partial", "none", "not-declared"] },
        "expected_cells": { "type": ["integer", "null"], "minimum": 0 },
        "recorded_cells": { "type": ["integer", "null"], "minimum": 0 },
        "executed_sha_verified": { "type": ["integer", "null"], "minimum": 0 },
        "lineage_missing": { "type": ["integer", "null"], "minimum": 0 },
        "final_record": { "type": ["boolean", "null"] },
        "reasons": { "type": "array", "items": { "type": "string" } }
      }
    },
    "verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "reasons"],
      "properties": {
        "value": { "type": "string", "enum": ["new-behavior", "unchanged", "recorded", "undeterminable"] },
        "reasons": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      }
    },
    "supersession": {
      "type": "object",
      "additionalProperties": false,
      "required": ["superseded", "record_head", "current_head", "reasons"],
      "description": "A record is bound to one head; when the PR head or base moves the record is superseded.",
      "properties": {
        "superseded": { "type": "boolean" },
        "record_head": { "$ref": "#/$defs/sha" },
        "current_head": { "$ref": "#/$defs/sha" },
        "reasons": { "type": "array", "items": { "type": "string" } }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["class", "text"],
        "properties": {
          "class": { "type": "string", "enum": ["observed-runtime-behavior", "comparison-result", "required-check-state", "reviewer-consumption-evidence", "intent-check-result", "unsupported-claim"] },
          "text": { "type": "string" }
        }
      }
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "steps", "claims", "uncovered", "stepsMissing"],
      "description": "Declared runtime claims about the change, evaluated against the scoped base-to-head delta. Present only when claims were declared.",
      "properties": {
        "outcome": { "type": "string", "enum": ["supported", "contradicted", "needs-explanation", "undeterminable"] },
        "steps": { "type": "array", "items": { "type": "string" } },
        "claims": { "type": "array", "items": { "$ref": "#/$defs/intentClaim" } },
        "uncovered": {
          "type": "object",
          "additionalProperties": false,
          "required": ["added", "removed"],
          "properties": {
            "added": { "type": "array", "items": { "$ref": "#/$defs/intentRow" } },
            "removed": { "type": "array", "items": { "$ref": "#/$defs/intentRow" } }
          }
        },
        "stepsMissing": {
          "type": "object",
          "additionalProperties": false,
          "required": ["base", "head"],
          "properties": {
            "base": { "type": "array", "items": { "type": "string" } },
            "head": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "repetitions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["per_side", "variance", "cells"],
      "description": "Live replays run each side more than once; a destination counts only when every repetition of a side recorded it.",
      "properties": {
        "per_side": { "type": "integer", "minimum": 1 },
        "variance": { "type": "integer", "minimum": 0 },
        "cells": { "type": "array", "items": { "$ref": "#/$defs/cell" } }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "state"],
      "properties": {
        "name": { "type": "string" },
        "state": { "type": "string" }
      }
    },
    "consumption": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["consumer", "evidence_url"],
        "properties": {
          "consumer": { "type": "string" },
          "evidence_url": { "type": "string", "format": "uri" }
        }
      }
    }
  },
  "$defs": {
    "sha": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" },
    "side": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha", "profile_id", "run_id"],
      "properties": {
        "sha": { "$ref": "#/$defs/sha" },
        "profile_id": { "type": ["string", "null"], "description": "Envelope Profile ID (the receipt id)." },
        "run_id": { "type": ["string", "null"], "description": "GitHub Actions run id." }
      }
    },
    "section": { "type": "string", "enum": ["workload", "runner background"] },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["side", "rep", "expected_sha", "executed_sha", "profile_present"],
      "properties": {
        "side": { "type": "string", "enum": ["baseline", "update"] },
        "rep": { "type": "integer", "minimum": 1 },
        "expected_sha": { "$ref": "#/$defs/sha" },
        "executed_sha": { "$ref": "#/$defs/sha" },
        "profile_present": { "type": "boolean" },
        "lineage_missing": { "type": ["integer", "null"], "minimum": 0 },
        "runner": { "type": ["string", "null"] },
        "image": { "type": ["string", "null"] }
      }
    },
    "addedRemoved": {
      "type": "object",
      "additionalProperties": false,
      "required": ["added", "removed"],
      "properties": {
        "added": { "type": ["integer", "null"], "minimum": 0 },
        "removed": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "networkEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["destination", "section"],
      "properties": {
        "destination": { "type": "string" },
        "section": { "$ref": "#/$defs/section" },
        "process": { "type": ["string", "null"], "description": "Process that acted (last element of the execution chain) when the record carries it." },
        "ancestry": { "type": "array", "items": { "type": "string" } },
        "step": { "type": ["string", "null"], "description": "Recorded workflow step name with the ordinal prefix stripped; null when the record carries none." }
      }
    },
    "intentClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "match", "expect", "outcome", "before", "after"],
      "properties": {
        "id": { "type": "string" },
        "kind": { "type": "string", "enum": ["network", "process"] },
        "match": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "destination": { "type": "string" },
            "ancestry": { "type": "string" }
          }
        },
        "expect": { "type": "string", "enum": ["present-before-absent-after", "absent-before-present-after", "present-both", "absent-both", "no-added", "no-removed"] },
        "outcome": { "type": "string", "enum": ["supported", "contradicted", "unobservable", "undeterminable"] },
        "reason": { "type": "string" },
        "before": { "type": "array", "items": { "type": "string" } },
        "after": { "type": "array", "items": { "type": "string" } },
        "steps": { "type": "array", "items": { "type": "string" } },
        "source": { "type": "string" }
      }
    },
    "intentRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["side", "step"],
      "properties": {
        "side": { "type": "string", "enum": ["added", "removed"] },
        "destination": { "type": "string" },
        "ancestry": { "type": "string" },
        "step": { "type": "string" }
      }
    },
    "processEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ancestry", "section"],
      "properties": {
        "ancestry": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "section": { "$ref": "#/$defs/section" },
        "step": { "type": ["string", "null"] }
      }
    },
    "fileEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "section"],
      "properties": {
        "path": { "type": "string" },
        "section": { "$ref": "#/$defs/section" },
        "process": { "type": ["string", "null"] }
      }
    }
  }
}
